.DS_Store
.gitignore
node_modules
public
prof
tsconfig.tsbuildinfo
.obsidian
.quartz-cache
private/
.replit
replit.nix
.quartz/
quartz/cli/tui/dist/

# Private vault folders (mirrors quartz.config.yaml's ignorePatterns, but
# that only controls what Quartz builds — git has no idea about it, so
# these also need to be excluded here or they get committed as real files
# whenever something resolves the `content` symlink and stages its contents.
content/00 inbox/
content/01 daily notes/
content/02 projects/
content/03 areas/
content/04 notes/
content/05 essays/
content/06 newsletters/
content/literature source/
content/readwise/
content/private/
content/templates/
content/obsidian/templates/
# .obsidian itself is already covered by the bare `.obsidian` pattern above
# (unanchored, so it matches at any depth, including content/.obsidian).
# .pandoc: tool config/cache, not content — also happens to contain a full
# export of the user's personal Zotero library (zotero-library-1.json),
# found during a pre-commit audit, never listed in ignorePatterns.
.pandoc
