@misc{projectveritasPART1Federal2021,
  title = {{{PART}} 1: {{Federal Govt HHS Whistleblower Goes Public With Secret Recordings}} "{{Vaccine}} Is {{Full}} of {{Sh}}*t"},
  shorttitle = {{{PART}} 1},
  year = 2021,
  month = sep,
