@article{langerEffectsChoiceEnhanced1976,
  title = {The Effects of Choice and Enhanced Personal Responsibility for the Aged: {{A}} Field Experiment in an Institutional Setting},
  shorttitle = {The Effects of Choice and Enhanced Personal Responsibility for the Aged},
  author = {Langer, Ellen J. and Rodin, Judith},
  year = 1976,
  journal = {Journal of Personality and Social Psychology},
  volume = {34},
  number = {2},
  pages = {191--198},
  publisher = {American Psychological Association},
  address = {US},
  issn = {1939-1315(Electronic),0022-3514(Print)},
  doi = {10.1037/0022-3514.34.2.191},
  abstract = {Conducted a field experiment to assess the effects of enhanced personal responsibility and choice on 91 nursing home residents. It was expected that the debilitated condition of many of the aged residing in institutional settings is, at least in part, a result of living in a virtually decision-free environment and, consequently, is potentially reversible. Residents who were in the experimental group were given a communication emphasizing their responsibility for themselves, whereas the communication given to a 2nd group stressed the staff's responsibility for them. In addition, to bolster the communication, the former group was given the freedom to make choices and the responsibility of caring for a plant rather than having decisions made and the plant taken care of for them by the staff, as was the case for the latter group. Questionnaire ratings and behavioral measures showed a significant improvement for the experimental group over the comparison group on alertness, active participation, and a general sense of well-being. (29 ref) (PsycInfo Database Record (c) 2020 APA, all rights reserved)},
  keywords = {Decision Making,Geriatric Patients,Group Participation,Interpersonal Interaction,Nursing Home Residents,Responsibility,Satisfaction}
}

